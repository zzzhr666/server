FROM ubuntu:24.04 AS build

ARG GRPC_VERSION=v1.80.0
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
      && apt-get install -y --no-install-recommends \
          ca-certificates \
          cmake \
          g++ \
          git \
          libgtest-dev \
          libspdlog-dev \
          ninja-build \
          pkg-config \
      && rm -rf /var/lib/apt/lists/*

RUN git clone --recurse-submodules \
          --branch ${GRPC_VERSION} \
          --depth 1 \
          --shallow-submodules \
          https://github.com/grpc/grpc \
          /opt/grpc

RUN cmake -S /opt/grpc -B /opt/grpc/build -G Ninja \
          -DCMAKE_BUILD_TYPE=Release \
          -DgRPC_BUILD_TESTS=OFF \
          -DgRPC_INSTALL=ON \
          -DgRPC_ABSL_PROVIDER=module \
          -DgRPC_CARES_PROVIDER=module \
          -DgRPC_PROTOBUF_PROVIDER=module \
          -DgRPC_RE2_PROVIDER=module \
          -DgRPC_SSL_PROVIDER=module \
      && cmake --build /opt/grpc/build --target install --parallel 2

RUN apt-get update \
      && apt-get install -y --no-install-recommends \
          prometheus-cpp-dev \
      && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY battle-server/ battle-server/

RUN cmake -S battle-server -B /build -G Ninja \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_PREFIX_PATH=/usr/local \
          -DProtobuf_ROOT=/usr/local \
      && cmake --build /build --target battle_server --parallel 2

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN apt-get update \
      && apt-get install -y --no-install-recommends \
          ca-certificates \
          libprometheus-cpp-core1.0 \
          libprometheus-cpp-pull1.0 \
          libspdlog1.12 \
          tzdata \
          zlib1g \
      && rm -rf /var/lib/apt/lists/* \
      && groupadd --system app \
      && useradd --system --gid app app

COPY --from=build /usr/local/lib/ /usr/local/lib/
COPY --from=build /build/battle_server /app/battle_server

RUN mkdir -p /app/logs \
      && chown -R app:app /app
RUN ldconfig

USER app
WORKDIR /app

EXPOSE 9200

ENTRYPOINT ["/app/battle_server"]

# syntax=docker/dockerfile:1.7

# The dependency image is built separately. This Dockerfile never clones or
# compiles gRPC/Protobuf; only the application source below is copied here.
FROM battle_deps AS build

WORKDIR /src

COPY battle-server/ battle-server/

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    cmake -S battle-server -B /build -G Ninja \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
          -DCMAKE_PREFIX_PATH=/usr/local \
          -DProtobuf_ROOT=/usr/local \
      && cmake --build /build --target battle_server --parallel 2

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN apt-get update \
      && apt-get install -y --no-install-recommends \
          ca-certificates \
          libprometheus-cpp-core1.0 \
          libprometheus-cpp-pull1.0 \
          libspdlog1.12 \
          tzdata \
          zlib1g \
      && rm -rf /var/lib/apt/lists/* \
      && groupadd --system app \
      && useradd --system --gid app app

COPY --from=build /usr/local/lib/ /usr/local/lib/
COPY --from=build /build/battle_server /app/battle_server

RUN mkdir -p /app/logs \
      && chown -R app:app /app \
      && ldconfig

USER app
WORKDIR /app

EXPOSE 9200

ENTRYPOINT ["/app/battle_server"]

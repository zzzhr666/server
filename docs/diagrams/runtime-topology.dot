digraph runtime_topology {
    rankdir=LR;
    node [shape=box, style=rounded];
    client [label="Client"];
    nginx [label="nginx :8080\\n可选"];
    logic1 [label="logic-server :8081"];
    logic2 [label="logic-server :8082"];
    state [label="state-server :9001"];
    redis [label="Redis :6379", shape=cylinder];
    rcenter [label="rcenter-server :9002"];
    battle [label="battle-server\\ncontrol :9101\\nUDP :7001"];
    client -> nginx [label="HTTP / WebSocket"];
    nginx -> logic1;
    nginx -> logic2;
    client -> logic1 [label="直连 HTTP / WS", style=dashed];
    client -> logic2 [label="直连 HTTP / WS", style=dashed];
    logic1 -> state [label="state gRPC"];
    logic2 -> state [label="state gRPC"];
    state -> redis [label="game:* 键"];
    logic1 -> rcenter [label="match gRPC"];
    logic2 -> rcenter [label="match gRPC"];
    battle -> rcenter [label="注册 / 结束对局"];
    rcenter -> battle [label="BattleControl gRPC"];
    client -> battle [label="UDP 包"];
}
